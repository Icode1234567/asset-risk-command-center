# Asset Risk Command Center - Environment Variables
# Copy this file and fill in your actual API keys

# NewsAPI key (https://newsapi.org) - used for fetching news articles
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage API key (https://www.alphavantage.co) - optional, for additional market data
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# CoinGecko API key (https://www.coingecko.com/en/api) - optional, free tier works without key
COINGECKO_API_KEY=
